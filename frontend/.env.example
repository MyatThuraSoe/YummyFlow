# REQUIRED. Base URL of the backend API — used as the Better Auth client
# baseURL (app/lib/auth-client.ts). Without it, auth requests hit the
# frontend origin and sign-in silently fails.
VITE_BACKEND_URL=http://localhost:5000

# Must equal VAPID_PUBLIC_KEY in backend/.env, or every push send fails
# with 401/403 (the browser subscribes under a different key pair).
VITE_VAPID_PUBLIC_KEY=

# EdgeStore public access key (same project as backend).
VITE_EDGE_STORE_ACCESS_KEY=

# Must equal CURRENCY in backend/.env. Supported: USD, THB, MMK, CNY.
# All money is rendered via formatMoney (app/lib/currency.ts).
VITE_CURRENCY=USD