# ── App ──────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────
# Local single-node replica set (Prisma requires a replica set for writes):
DATABASE_URL=mongodb://127.0.0.1:27017/dineflow?replicaSet=rs0

# ── Better Auth ───────────────────────────────────────
# Generate a random 32+ character secret:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# ── Google OAuth (optional) ───────────────────────────
# OAuth 2.0 Client ID (Web application). Redirect URI:
#   http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini AI (optional) ──────────────────────────────
# Without a key, AI briefings still generate from the deterministic
# analytics engine (generatedBy = "heuristic").
GEMINI_API_KEY=

# ── Inngest ───────────────────────────────────────────
# For local dev, "local" works with the Inngest Dev Server. Production
# REQUIRES real event/signing keys (the app refuses to start jobs with
# the local placeholders in production).
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# ── EdgeStore (file uploads) ──────────────────────────
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=

# ── Email (Nodemailer) ────────────────────────────────
# Leave SMTP_HOST and SMTP_PORT EMPTY to run in "outbox mode": every email
# is rendered to backend/.mail-outbox/ instead of being delivered.
# Fill these in to deliver for real (Gmail example: smtp.gmail.com / 587
# with a 16-character App Password).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@dineflow.local
MAIL_FROM_NAME=DineFlow

# ── Browser push (Web Push / VAPID) ───────────────────
# Generate a key pair once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VITE_VAPID_PUBLIC_KEY in frontend/.env MUST be the SAME public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dineflow.local

# ── Currency (single source of truth) ─────────────────
# Must equal VITE_CURRENCY in frontend/.env. Supported codes:
# USD, THB, MMK, CNY. Amounts are stored unlabelled and formatted only at
# the UI layer — never hardcode "$" in components, always use formatMoney.
CURRENCY=USD