# ── Database (local dev: docker compose up -d postgres) ─────────────
DATABASE_URL=postgresql://megadine:megadine_secure_2026@localhost:5432/megadine_pos?schema=public

# ── App ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Frontend origin, comma-separated if multiple.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
# Set true only behind HTTPS. Leave false for plain-HTTP LAN installs or the
# browser will silently drop the session cookie.
COOKIE_SECURE=false

# Restaurant defaults (overridable in the Settings page)
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0.085
DEFAULT_SERVICE_CHARGE=0
DEFAULT_BUSINESS_DAY_CUTOFF=04:00

# Hardware
PRINTER_MODE=simulate        # simulate | tcp
RECEIPT_PRINTER_IP=192.168.1.50
KITCHEN_PRINTER_IP=192.168.1.51

# License (optional; empty = Basic edition defaults: 2 terminals / 15 tables / 50 items)
# Mint a hardware-bound key with: npm --prefix backend run make-license
LICENSE_KEY=
# Public key (single-line base64 SPKI DER) used to verify the license signature.
MEGACODE_LICENSE_PUBLIC_KEY=
# Machine id the license is bound to. REQUIRED in Docker (otherwise every
# rebuild generates a new id and the license stops matching).
MACHINE_ID=

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Mount point / path of a USB stick for off-site export (empty = disabled)
USB_EXPORT_DIR=

# Auth hardening
SESSION_TTL_HOURS=12
MAX_PIN_ATTEMPTS=3
LOCKOUT_MINUTES=5

# Realtime (optional: enables multi-process/pub-sub socket fan-out)
REDIS_URL=redis://localhost:6379